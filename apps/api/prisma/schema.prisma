// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Note {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  visibility NoteVisibility @default(PRIVATE)
  isLocked  Boolean  @default(false)
  contentEncryptionSalt String?
  contentEncryptionIv   String?
  collaborationState Bytes?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tags Tag[]
  shareLink NoteShareLink?
  collaborators NoteCollaborator[]
}

enum NoteVisibility {
  PRIVATE
  PUBLIC
}

enum NoteCollaboratorRole {
  VIEWER
  EDITOR
}

model NoteShareLink {
  id        Int      @id @default(autoincrement())
  token     String?
  tokenHash String   @unique
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  noteId Int  @unique
  note   Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
}

model NoteCollaborator {
  noteId Int
  userId Int
  role   NoteCollaboratorRole
  createdAt DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
  @@index([userId])
}

model Tag {
  id     Int @id @default(autoincrement())
  name   String

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  notes  Note[]
}

model User {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  password   String?
  tokenVersion Int       @default(0)
  createdAt  DateTime   @default(now())

  username   String?    @unique
  profileImageUrl String?

  identities Identity[]
  notes      Note[]
  tags       Tag[]
  sharedNotes NoteCollaborator[]
}

model Identity {
  id         Int    @id @default(autoincrement())
  provider   String
  providerId String

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}
